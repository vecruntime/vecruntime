# An opt-in profiling layer over a bench image (#672): async-profiler under /opt/async-profiler, for
# `-agentpath:/opt/async-profiler/lib/libasyncProfiler.so=start,event=nativemem,...` on the driver or
# the executors. The default image (Dockerfile) is unchanged; build this one on top of it:
#
#   kaniko --dockerfile=benchmarks/k8s/Dockerfile.asprof --build-arg BASE=<registry>/spark:<tag> \
#          [--build-arg ASPROF_ARCH=arm64 --build-arg ASPROF_SHA256=<sha of the arm64 tarball>]
ARG BASE
FROM ${BASE}
ARG ASPROF_VERSION=4.5
ARG ASPROF_ARCH=x64
# sha256 of async-profiler-4.5-linux-x64.tar.gz (GitHub release asset digest)
ARG ASPROF_SHA256=89546fbb9ee0fc5496c7edd4099b0709489bc78b0d8057ccbb4b801f6b032b62
USER root
RUN curl -fsSL -o /tmp/ap.tgz \
      "https://github.com/async-profiler/async-profiler/releases/download/v${ASPROF_VERSION}/async-profiler-${ASPROF_VERSION}-linux-${ASPROF_ARCH}.tar.gz" \
    && echo "${ASPROF_SHA256}  /tmp/ap.tgz" | sha256sum -c - \
    && mkdir -p /opt/async-profiler && tar -xzf /tmp/ap.tgz -C /opt/async-profiler --strip-components=1 \
    && rm /tmp/ap.tgz && chmod -R a+rX /opt/async-profiler \
    && test -f /opt/async-profiler/lib/libasyncProfiler.so
USER spark
