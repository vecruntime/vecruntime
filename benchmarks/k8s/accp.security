# Amazon Corretto Crypto Provider (ACCP) first, the JDK's providers after it in their default order (#566).
# Loaded with -Djava.security.properties=/opt/spark/accp/accp.security (one '=' adds to the JDK's own
# java.security, overriding only these keys). ACCP serves AES-GCM (the TLS record cipher of the S3 reads),
# SHA-2 and HMAC (SigV4 signing) natively; anything it does not implement falls through to the JDK's.
security.provider.1=com.amazon.corretto.crypto.provider.AmazonCorrettoCryptoProvider
security.provider.2=SUN
security.provider.3=SunRsaSign
security.provider.4=SunEC
security.provider.5=SunJSSE
security.provider.6=SunJCE
security.provider.7=SunJGSS
security.provider.8=SunSASL
security.provider.9=XMLDSig
security.provider.10=SunPCSC
security.provider.11=JdkLDAP
security.provider.12=JdkSASL
security.provider.13=SunPKCS11
