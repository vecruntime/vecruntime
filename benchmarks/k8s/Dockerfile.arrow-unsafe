# Bench-only layer (#840 direct memory): adds Arrow's malloc-backed allocation manager next to the Netty one
# Spark ships, so `-Darrow.allocation.manager.type=Unsafe` moves Arrow buffers out of MaxDirectMemorySize.
#
#   kaniko --dockerfile=benchmarks/k8s/Dockerfile.arrow-unsafe --build-arg BASE=<registry>/spark:<tag>
ARG BASE
FROM ${BASE}
ARG ARROW_VERSION=18.3.0
# sha256 of arrow-memory-unsafe-18.3.0.jar (Maven Central; sha1 12cf6b2b0323899ef4f8909ed5411efbd82d6d9b)
ARG AMU_SHA256=e9652f322d7be306c400ea0d775b3114a11b48d2afe23e8b8566f13c469d5483
USER root
RUN curl -fsSL -o /opt/spark/jars/arrow-memory-unsafe-${ARROW_VERSION}.jar \
      "https://repo1.maven.org/maven2/org/apache/arrow/arrow-memory-unsafe/${ARROW_VERSION}/arrow-memory-unsafe-${ARROW_VERSION}.jar" \
    && echo "${AMU_SHA256}  /opt/spark/jars/arrow-memory-unsafe-${ARROW_VERSION}.jar" | sha256sum -c - \
    && chmod 644 /opt/spark/jars/arrow-memory-unsafe-${ARROW_VERSION}.jar \
    && ls /opt/spark/jars/*.jar | LC_ALL=C sort | paste -sd: > /opt/spark/aot/classpath \
    && grep -q arrow-memory-unsafe /opt/spark/aot/classpath && chmod a+r /opt/spark/aot/classpath
# (The executor's class path is the sorted jar list in /opt/spark/aot/classpath, not jars/*: the base image's
# Dockerfile writes it for the AOT cache, so a jar added here must be added to that list too.)
USER spark
