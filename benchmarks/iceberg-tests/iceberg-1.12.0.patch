+package org.apache.iceberg.spark;
+
+import org.apache.spark.sql.SparkSession;
+
+/**
+ * Injects the vecruntime (spark-vector) plugin into the SparkSession built by the Iceberg Spark
+ * test bases, so Apache Iceberg's OWN Spark 4.1 suites run with vecruntime's path on. This is NOT
+ * part of Iceberg; it is applied by the crew harness patch
+ * (benchmarks/iceberg-tests/iceberg-1.12.0.patch in vecruntime/vecruntime) and reverted after the
+ * run.
+ *
+ * <p>How the plugin gets wired:
+ *
+ * <ul>
+ *   <li>{@code spark.plugins=io.vecruntime.spark.VectorPlugin} registers the plugin. Its driver side
+ *       idempotently APPENDS {@code io.vecruntime.spark.VectorSparkSessionExtensions} to
+ *       {@code spark.sql.extensions}, so in the extensions suites the chain becomes
+ *       {@code IcebergSparkSessionExtensions,VectorSparkSessionExtensions} with no double
+ *       registration -- we do not touch {@code spark.sql.extensions} here.
+ *   <li>The vecruntime jars (kernels, parquet, spark, shuffle, iceberg-bridge) are put on the test
+ *       runtime classpath by the patched build.gradle via {@code testRuntimeOnly files(...)}, keyed
+ *       off the system property {@code vecruntime.jars} that the driver script sets.
+ *   <li>The JVM args the plugin needs (--add-modules=jdk.incubator.vector,
+ *       --enable-native-access=ALL-UNNAMED, --sun-misc-unsafe-memory-access=allow) are added to the
+ *       test task JVM by the patched build.gradle (the session runs {@code local[2]}, in process, so
+ *       the Gradle test JVM IS the driver and the executor).
+ * </ul>
+ *
+ * <p>Set {@code -Dvecruntime.enabled=false} to make this a no-op: the same harness then runs the
+ * suites on vanilla Iceberg, which is the "plugin OFF" baseline the triage compares against.
+ */
+public final class VectorTestConf {
+
+  private VectorTestConf() {}
+
+  public static final boolean ENABLED =
+      Boolean.parseBoolean(System.getProperty("vecruntime.enabled", "true"));
+
+  private static final String PLUGIN = "io.vecruntime.spark.VectorPlugin";
+
+  /** Returns the builder with the vecruntime plugin wired in, or unchanged when disabled. */
+  public static SparkSession.Builder apply(SparkSession.Builder builder) {
+    if (!ENABLED) {
+      return builder;
+    }
+
+    builder
+        .config("spark.plugins", PLUGIN)
+        // Native Iceberg scan (read side) and the columnar / merge-on-read writers. The writers and
+        // the native-scan switch default OFF in vecruntime main while they land slice by slice
+        // (VectorConf: scan.nativeIceberg, iceberg.writer, iceberg.dvWriter are all off by default);
+        // the whole point of this harness is to exercise them, so turn them on explicitly.
+        .config("spark.vecruntime.scan.nativeIceberg.enabled", "true")
+        .config("spark.vecruntime.iceberg.readSpecs.enabled", "true")
+        .config("spark.vecruntime.iceberg.nativeEqualityDeletes.enabled", "true")
+        .config("spark.vecruntime.iceberg.writer.enabled", "true")
+        .config("spark.vecruntime.iceberg.dvWriter.enabled", "true")
+        .config("spark.vecruntime.iceberg.positionDeletes.enabled", "true")
+        // The columnar writer sorts partitioned / bucketed output off-heap; only the off-heap pool
+        // tracks that native memory, so the writer docs require it on for those writes.
+        .config("spark.memory.offHeap.enabled", "true")
+        .config("spark.memory.offHeap.size", "1g");
+
+    return builder;
+  }
+}
