+package org.apache.iceberg.spark;
+
+import org.apache.spark.sql.SparkSession;
+
+/**
+ * Injects the vecruntime (spark-vector) plugin into the SparkSession built by the Iceberg Spark
+ * test bases, so Apache Iceberg's OWN Spark 4.1 suites run with vecruntime's path on. This is NOT
+ * part of Iceberg; it is applied by the crew harness patch
+ * (benchmarks/iceberg-tests/iceberg-1.12.0.patch in vecruntime/vecruntime) and reverted after the
+ * run.
+ *
+ * <p>Wiring: {@code spark.plugins=io.vecruntime.spark.VectorPlugin} registers the plugin, whose
+ * driver side idempotently appends {@code VectorSparkSessionExtensions} to
+ * {@code spark.sql.extensions} (so the extensions suites get
+ * {@code IcebergSparkSessionExtensions,VectorSparkSessionExtensions}). The jars reach the test
+ * runtime via {@code -Dvecruntime.jars} ({@code testRuntimeOnly files(...)} in the patched
+ * build.gradle); the Vector-API JVM args and the JDK-25 test toolchain are set there too.
+ *
+ * <p>{@code -Dvecruntime.enabled=false} makes this a no-op (the vanilla-Iceberg baseline).
+ *
+ * <p>WRITE PATH -- default OFF here (see {@code WRITERS}). The columnar Iceberg data-file writer and
+ * the merge-on-read DV writer live in {@code iceberg-bridge}, which is COMPILED AGAINST Iceberg's
+ * SHADED {@code iceberg-spark-runtime} jar (parquet relocated under
+ * {@code org.apache.iceberg.shaded.*}). Iceberg's own Gradle test modules are UNSHADED, so the
+ * bridge's {@code IcebergParquetInterop.fileSchema} -> {@code ParquetSchemaUtil.convert(...)} binds
+ * to a shaded return type that the unshaded {@code ParquetSchemaUtil} on the test classpath does
+ * not have, giving {@code NoSuchMethodError} on every write. This is a harness/packaging
+ * incompatibility, not a writer-logic bug (a real Spark deployment loads the shaded runtime jar and
+ * the writer works). Until the bridge is built in an unshaded variant for this harness, OR the
+ * suites are run against the shaded runtime jar, keep the writers off: the native SCAN path
+ * (readSpecs + nativeEqualityDeletes) is exercised fully and passes. {@code -Dvecruntime.writers=on}
+ * turns them on to reproduce the incompatibility.
+ */
+public final class VectorTestConf {
+
+  private VectorTestConf() {}
+
+  public static final boolean ENABLED =
+      Boolean.parseBoolean(System.getProperty("vecruntime.enabled", "true"));
+
+  /** Write path off by default (see the class javadoc); -Dvecruntime.writers=on turns it on. */
+  public static final boolean WRITERS =
+      "on".equalsIgnoreCase(System.getProperty("vecruntime.writers", "off"));
+
+  private static final String PLUGIN = "io.vecruntime.spark.VectorPlugin";
+
+  /** Returns the builder with the vecruntime plugin wired in, or unchanged when disabled. */
+  public static SparkSession.Builder apply(SparkSession.Builder builder) {
+    if (!ENABLED) {
+      return builder;
+    }
+
+    builder
+        .config("spark.plugins", PLUGIN)
+        // Native Iceberg scan (read side) -- on.
+        .config("spark.vecruntime.scan.nativeIceberg.enabled", "true")
+        .config("spark.vecruntime.iceberg.readSpecs.enabled", "true")
+        .config("spark.vecruntime.iceberg.nativeEqualityDeletes.enabled", "true")
+        // Columnar + merge-on-read writers -- controlled by -Dvecruntime.writers (default off).
+        .config("spark.vecruntime.iceberg.writer.enabled", String.valueOf(WRITERS))
+        .config("spark.vecruntime.iceberg.dvWriter.enabled", String.valueOf(WRITERS))
+        .config("spark.vecruntime.iceberg.positionDeletes.enabled", String.valueOf(WRITERS));
+
+    if (WRITERS) {
+      // The columnar writer sorts partitioned / bucketed output off-heap; only the off-heap pool
+      // tracks that native memory, so the writer docs require it on for those writes.
+      builder
+          .config("spark.memory.offHeap.enabled", "true")
+          .config("spark.memory.offHeap.size", "1g");
+    }
+
+    return builder;
+  }
+}
