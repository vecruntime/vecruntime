+    }
+    // The spark-vector plugin needs the Vector API module and native access (crew patch).
+    jvmArgs '--add-modules=jdk.incubator.vector',
+            '--enable-native-access=ALL-UNNAMED',
+            '--sun-misc-unsafe-memory-access=allow'
+    if (System.getProperty('vecruntime.jars')) {
+      systemProperty 'vecruntime.jars', System.getProperty('vecruntime.jars')
+    }
+    if (System.getProperty('vecruntime.enabled')) {
+      systemProperty 'vecruntime.enabled', System.getProperty('vecruntime.enabled')
+    }
+    // Harness exclusions (crew patch): -Dvecruntime.excludeTests=Class#method,Class,... skips the
+    // tests triaged out in benchmarks/iceberg-tests/exclusions.txt. '#' is turned into '.' because
+    // Gradle's excludeTestsMatching matches fully-qualified Class.method names.
+    if (System.getProperty('vecruntime.excludeTests')) {
+      filter {
+        System.getProperty('vecruntime.excludeTests').split(',').each { pat ->
+          if (pat?.trim()) { excludeTestsMatching pat.trim().replace('#', '.') }
+        }
+      }
+    }
   }
 
