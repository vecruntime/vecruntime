   test {
     useJUnitPlatform()
+    // Iceberg's Gradle must launch on JDK 17/21, but the spark-vector jars need JDK 25 at test
+    // runtime (the Vector API incubator module). Run the TEST JVM on the JDK 25 toolchain while
+    // Gradle itself stays on 21 (crew patch). The JDK 25 home is supplied to Gradle via
+    // -Porg.gradle.java.installations.paths=<jdk25> by the driver / CI.
+    if (System.getProperty('vecruntime.testJavaVersion')) {
+      javaLauncher = javaToolchains.launcherFor {
